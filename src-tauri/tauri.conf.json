{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AQlicker",
  "version": "0.1.0",
  "identifier": "ca.aatricks.aqlicker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AQlicker",
        "width": 560,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "icon": ["icons/icon.png"]
  }
}
